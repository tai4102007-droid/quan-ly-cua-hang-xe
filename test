class store
{
    private:
    std::vector<product*> products;
    public:
    store(){}
    void addProduct()
    {
        product *p=nullptr;
        int choice;
        std::cout<<"Choose an option: "<<std::endl
                 <<"1. Add a phone."<<std::endl
                 <<"2. Add a accessory."<<std::endl;
        do
        {
            std::cin>>choice;
            std::cin.ignore();            
            if(choice !=1 && choice !=2)
            std::cout<<"Invalid!"<<std::endl;
        }
        while(choice !=1 && choice !=2);
        switch(choice)
        {
            case 1:
            {
                p=new phone();
                p->input();
                break;
            }
            case 2:
            {
                p=new accessory();
                p->input();
                break;
            }
            default:
                break;
        }
        products.push_back(p);
    }
    void showProduct() const
    {
        for( product *p : products)
        {
            p->output();
        }
    }
    ~ store()
    {
        for( product *p: products)
        {
            delete (p);
        }
    }
    void searchProduct()
    {
        bool found=false;
        std::string getName;
        getline(std::cin,getName);  
        for(const product *p : products)
        {
        if(p->getName()==getName)
        {
            p->output();
            found=true;
        }
        }
        if(found==false)
        {
            std::cout<<"Can't found!"<<std::endl;
        }
    }
    void totalprice()
    {
        double total=0;
        double price;
        int quantity;
        for( product *p : products)
        {
            price=p-> getprice();
            quantity=p-> getquantity();
            total += (price*quantity);
        }
        std::cout<<"Total price: "<<total<<"USD"<<std::endl;
    }
    void sortProduct()
    {
        for(int i=0; i< products.size();i++)
        {
            for(int j=i+1; j< products.size();j++)
            {
                if((products[i]->getprice()) < (products[j]-> getprice()) )
                {
                    product *temp;
                    temp=products[i];
                    products[i]=products[j];
                    products[j]=temp;
                }
            }
        }
        showProduct();
    }
    void editProduct()
    {
            std::string id;
            std::cin.ignore();
            getline(std::cin,id);
            bool found= false;
            for(int i=0;i<products.size();i++)
            {
                if(id==products[i]->getID())
                {
                    found=true;
                    products[i]-> input();
                    std::cout<<"Edit successfully!"<<std::endl;
                    break;
                }
            }
            if(found==false)
            {
                std::cout<<"Can't found this product!"<<std::endl;
            }

    }
    void deleteProduct()
    {
        std::string id;
        getline(std::cin,id);
        bool found= false;
            for(int i=0;i<products.size();i++)
            {
                if(id==products[i]->getID())
                {
                    found=true;
                    delete(products[i]);
                    products.erase(products.begin()+i);
                    std::cout<<"Delete successfully!"<<std::endl;
                    break;
                }
            }
            if(found==false)
            {
                std::cout<<"Can't found this product!"<<std::endl;
            }
    }
    product* foundProduct()
    {
        std::string id;
        getline(std::cin,id);
        bool found=false;
        for(product *p: products)
        {
            if(id==p->getID())
            {
                std::cout<<"Find successfully!"<<std::endl;
                found=true;
                return p;
            }
        }
        if(found==false)
        {
            std::cout<<"Can't find this product!"<<std::endl;
            return nullptr;
        }
    }
};
