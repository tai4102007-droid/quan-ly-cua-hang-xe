class product
{
    private:
    std::string id;
    std::string name;
    double price;
    int quantity;
    public:
    product()
    {
        id="";
        name="";
        price=0;
        quantity=0;
    }
    virtual void input()
    {
        std::cout<<"ID: ";
        getline(std::cin,id);
        std::cout<<"Name device: ";
        getline(std::cin,name);
        do{
            std::cout<<"Price: ";
            std::cin>>price;
            if(price<0)
            std::cout<<"Invalid! "<<std::endl;
        }
        while(price<0);
        do {
        std::cout << "Quantity: ";
         std::cin >> quantity;
         if (quantity < 0) {
        std::cout << "Invalid! " << std::endl;
    }
} while (quantity < 0);
    }
    virtual void output() const
    {
        std::cout<<"ID: "<<id<<std::endl
                 <<"Name: "<<name<<std::endl
                 <<"Price: "<<price<<std::endl;
    }
    virtual void Quantities() const
    {
        std::cout<<"Stock quantity: "<<quantity<<std::endl;
    }
    double getprice() const
    {
        return price;
    }
    int getquantity() const
    {
        return quantity;
    }
    std::string getName() const
    {
        return name;
    }
    std::string getID() const
    {
        return id;
    }
    void reduceQuantity(int amount)
    {
        quantity-=amount;
    }
    virtual ~product()=default;
};
